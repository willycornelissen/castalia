# Firebase Client Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: Public Base Path (defaults to / for Firebase Hosting at https://castalia.web.app)
# VITE_BASE_PATH=/

# Admin UID for Security Rules Deployment (server-side enforcement)
ADMIN_UID=your_firebase_admin_uid_here

# Optional: Client-side Admin UI Guard (defense-in-depth, matches ADMIN_UID)
VITE_FIREBASE_ADMIN_UID=

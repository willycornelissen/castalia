rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "ADMIN_UID_ENV_PLACEHOLDER";
    }

    match /posts/{slug} {
      // Safe read: handles 404 queries (resource == null) without throwing permission errors
      allow get: if resource == null || resource.data.status == 'published' || isAdmin();
      allow list: if isAdmin() || (request.query.limit <= 20 && resource.data.status == 'published');

      // Strict write: prevents overwriting existing documents on create
      allow create: if isAdmin()
                    && !exists(/databases/$(database)/documents/posts/$(slug))
                    && request.resource.data.slug == slug
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.status in ['draft', 'published']
                    && request.resource.data.content_markdown is string
                    && request.resource.data.excerpt is string
                    && request.resource.data.tags is list
                    && (!('template' in request.resource.data) || request.resource.data.template in ['article', 'resenha']);

      allow update: if isAdmin()
                    && request.resource.data.slug == slug
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.status in ['draft', 'published']
                    && request.resource.data.content_markdown is string
                    && request.resource.data.excerpt is string
                    && request.resource.data.tags is list
                    && (!('template' in request.resource.data) || request.resource.data.template in ['article', 'resenha'])
                    && (resource.data.status != 'published' || request.resource.data.slug == resource.data.slug);

      allow delete: if isAdmin();
    }

    match /settings/navigation {
      allow get: if true;
      allow create, update: if isAdmin()
                            && request.resource.data.items is list
                            && request.resource.data.items.size() > 0
                            && request.resource.data.items.size() <= 20;
      allow delete: if isAdmin();
    }

    match /media/{mediaId} {
      allow get: if true;
      allow create, update: if isAdmin()
                            && request.resource.data.data_url is string
                            && request.resource.data.data_url.matches('^data:image/(webp|jpeg|png);base64,.+')
                            && request.resource.data.data_url.size() <= 900000;
      allow delete: if isAdmin();
    }
  }
}
